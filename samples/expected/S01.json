{
  "schema": "codebridge.eval-expected/1",
  "case": "S01",
  "about": "Reference case: glioblastoma, four lab draws, clean print (samples/S01_pacient)",
  "documents": [{"document_id": "S01_pacient", "pages_dir": "data/derived/pages/S01_pacient"}],
  "reference_labs": "fixtures/data/mock-case-S01.json",
  "expectations": [
    {"id": "S01-mri-report-missing", "failure_kind": "report_missing", "expect": "present",
     "about": "The MRI of 29.9.2026 is only quoted (popis z NIS); its original report is missing",
     "alert": {"kind": "missing", "fact.kind": "imaging", "fact.date.sort": "2026-09-29"}},
    {"id": "S01-mri-cited-not-original", "failure_kind": "report_missing", "expect": "present",
     "about": "The MRI of 29.9.2026 is a cited result, not an original report",
     "fact": {"kind": "imaging", "date.sort": "2026-09-29", "source.reported_as": "cited"}},
    {"id": "S01-pet-requested-not-done", "failure_kind": "request_without_result", "expect": "present",
     "about": "PET/CT with 18F-FET was requested on 1.10.2026 and has no result",
     "fact": {"kind": "request", "status": "requested", "value.what": {"regex": "(?i)PET"}, "value.result_fact": null}},
    {"id": "S01-pet-never-done", "failure_kind": "request_without_result", "expect": "absent",
     "about": "The PET/CT is never shown as performed",
     "fact": {"kind": {"in": ["imaging", "request"]}, "status": "done", "source.quote": {"regex": "PET"}}, "needs": ["request", "imaging"]},
    {"id": "S01-pet-alert", "failure_kind": "request_without_result", "expect": "present",
     "about": "The request without a result raises the request_without_result alert",
     "alert": {"rule": "request_without_result", "fact.value.what": {"regex": "(?i)PET"}}, "needs": ["request"]},
    {"id": "S01-dm-recorded-negative", "failure_kind": "negation_read_as_positive", "expect": "present",
     "about": "'DM neguje' is the doctor's recorded negative: a negated comorbidity",
     "fact": {"kind": "comorbidity", "negated": true, "source.quote": {"regex": "DM neguje"}}},
    {"id": "S01-no-dm-diagnosis", "failure_kind": "negation_read_as_positive", "expect": "absent",
     "about": "Diabetes is never a comorbidity or diagnosis of this patient",
     "fact": {"kind": {"in": ["comorbidity", "diagnosis"]}, "negated": false, "source.quote": {"regex": "DM neguje"}}, "needs": ["comorbidity"]},
    {"id": "S01-diagnosis", "failure_kind": "critical_fact_left_out", "expect": "present",
     "about": "The diagnosis glioblastoma, confirmed by histology, is in the run",
     "fact": {"kind": "diagnosis", "value.text": {"regex": "(?i)glioblastom"}}},
    {"id": "S01-no-lab-contradiction", "failure_kind": "reference", "expect": "absent",
     "about": "The values quoted in the report match the lab sheets: no contradiction alert",
     "alert": {"kind": "contradiction", "fact.kind": "lab_result"}}
  ]
}
