# Slovak, translated from the Czech source catalog (i18n/cs/auth.ftl, docs/design/I18N.md). Message IDs are the same
# as in Czech. The login pages of the Worker (api/src/auth/pages.ts). A message missing here falls back to Czech.
#
## Glossary (Czech -> Slovak), for review
# přihlášení -> prihlásenie
# organizace -> organizácia
# správce -> správca

## Login pages of the Worker

auth-page-app = GLIDE MDT
auth-no-access-title = Nemáte prístup
auth-no-access-body = Prihlásenie prebehlo, ale tento účet nemá v GLIDE MDT aktívne členstvo v žiadnej organizácii. O prístup požiadajte správcu svojej organizácie.
auth-no-access-other = Prihlásiť iným účtom
auth-failed-title = Prihlásenie sa nepodarilo
auth-failed-body = Prihlásenie sa nedokončilo, napríklad preto, že vypršalo alebo bolo otvorené dvakrát. Nič sa neuložilo.
auth-unavailable-title = Prihlasovacia služba je nedostupná
auth-unavailable-body = Prihlasovaciu službu sa teraz nepodarilo zastihnúť. Skúste to prosím o chvíľu.
auth-misconfigured-title = Prihlásenie nie je nastavené
auth-misconfigured-body = Prihlásenie nie je na tomto serveri správne nastavené. Obráťte sa na správcu aplikácie.
auth-retry = Skúsiť znova
auth-done-title = Prihlásenie obnovené
auth-done-body = Toto okno môžete zavrieť. V pôvodnom okne kliknite na „Skúsiť znova“ a neuložené zmeny sa uložia.
