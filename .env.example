# Server-side only. Never include this key in browser JavaScript or a Git commit.
OPENROUTER_API_KEY=
# Verified against OpenRouter public catalog on 2026-10-17; no implicit fallback.
OPENROUTER_MODEL_ASTRA=openai/gpt-6-astra

# Lower reasoning budget keeps the single search responsive.
# Applied only when the selected model advertises this effort in its catalog.
OPENROUTER_REASONING_EFFORT=low
