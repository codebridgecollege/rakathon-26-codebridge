# Server-side only. Never include this key in browser JavaScript or a Git commit.
OPENROUTER_API_KEY=
# Verified against OpenRouter public catalog on 2026-10-17; no implicit fallback.
OPENROUTER_MODEL_ASTRA=openai/gpt-6-astra

# Lower reasoning budget keeps the single search responsive.
# Applied only when the selected model advertises this effort in its catalog.
OPENROUTER_REASONING_EFFORT=low

# Server routes. The API Worker (api/) reads these from api/wrangler.jsonc vars
# and, for keys, from Wrangler secrets or api/.dev.vars; .env is for the
# Python scripts. The names are the same everywhere.
# Speech-to-text for "AI záznam" (server-side only; the page never holds it).
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE=https://api.elevenlabs.io
STT_REALTIME_MODEL=scribe_v2_realtime
STT_BATCH_MODEL=scribe_v2
STT_LANGUAGE=cs
STT_MAX_AUDIO_BYTES=100000000
# Speaker pass on the Worker (step 5): batch seed, audio part size, cap per case.
STT_BATCH_SEED=1
AUDIO_PART_BYTES=5242880
AUDIO_MAX_MINUTES_PER_CASE=120
# Summary of a recorded MDT discussion (hackathon Azure OpenAI gateway, EU).
AZURE_OPENAI_KEY=
AZURE_OPENAI_BASE=https://apim-rakathon-q7146n.azure-api.net/openai/v1
AZURE_OPENAI_MODEL=gpt-6-luna-dz-eu
SUMMARY_MAX_CHARS=40000
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_MS=1000
# Optional Cloudflare AI Gateway in front of the summary call; empty means off.
AI_GATEWAY_BASE=
AI_GATEWAY_TOKEN=
# demo (no login, the UI labels roles as a stand-in) or oidc (the login at Zitadel; docs/design/AUTH.md).
AUTH_MODE=demo
OIDC_ISSUER=https://glide-mdt--dev-dybk0r.eu1.zitadel.cloud
OIDC_CLIENT_ID=395716705399111846
# Secrets of the login (never commit them): the Zitadel web app's secret, and 32 random bytes, base64.
OIDC_CLIENT_SECRET=
SESSION_KEY=
# Set by CI to the commit; shown by GET /api/health.
GIT_SHA=dev
# Uploads and the document pipeline on the Worker (step 6): which files the upload route stores
# (fixtures_only | store_unprocessed), the size limit, where a local page reader service runs (PAGE_READER_URL), whether
# the deployed page reader container is used (PAGE_READER_CONTAINER on|off; only the deploy commands set "on"), and the
# orgs the pipeline runs for (PIPELINE_ORGS, comma-separated org ids or "*"). No URL and no container: pipeline off.
UPLOAD_POLICY=fixtures_only
# Orgs whose unknown uploads (PDF, JPEG/PNG photo) keep their content whatever UPLOAD_POLICY says; the team's switch.
UPLOAD_STORE_ORGS=
UPLOAD_MAX_BYTES=20971520
PAGE_READER_URL=
PAGE_READER_CONTAINER=off
PIPELINE_ORGS=demo-b
# The extraction format's JSON Schema for the Python pipeline (pipeline/extraction_format); empty uses
# packages/domain/schema/extraction-2.schema.json from the repository. Set it where packages/ is not copied.
CODEBRIDGE_EXTRACTION_SCHEMA=
