{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-em-dashes.py\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./private/**)",
      "Edit(./private/**)",
      "Grep(./private/**)",
      "Glob(./private/**)",
      "Bash(cat private/*)",
      "Bash(head private/*)",
      "Bash(tail private/*)",
      "Bash(less private/*)",
      "Bash(grep * private/*)"
    ]
  }
}
