{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-em-dashes.py\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./data/**)",
      "Edit(./data/**)",
      "Grep(./data/**)",
      "Glob(./data/**)",
      "Bash(cat data/*)",
      "Bash(head data/*)",
      "Bash(tail data/*)",
      "Bash(less data/*)",
      "Bash(grep * data/*)"
    ]
  }
}
