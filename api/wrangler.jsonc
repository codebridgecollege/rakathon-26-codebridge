{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codebridge-mdt",
  "main": "src/index.ts",
  // Pinned so the runtime behaves the same on every deploy; not later than Wrangler 4.147.0's workerd.
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  // The backend branch deploys as a preview alias (backend-codebridge-mdt.<subdomain>.workers.dev).
  "preview_urls": true,
  "assets": {
    "directory": "./.assets",
    "binding": "ASSETS",
    // Only the API runs code; pages and images are served as files, as on Pages today.
    // Switch to true when AUTH_MODE=access so the Worker checks the session before any file (second line behind Access).
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Logs hold route, status and timing only; handlers never log transcripts, audio or tokens.
  "observability": { "enabled": true },
  // Case data (step 2). Both were created with the EU jurisdiction; it can only be set at creation, and
  // `wrangler d1 info codebridge-mdt` reports "jurisdiction: eu". Identity lives in D1's patients table only.
  "d1_databases": [
    { "binding": "DB", "database_name": "codebridge-mdt", "database_id": "eac0ab4e-59fc-46a1-86cc-69b2f5f4b344", "migrations_dir": "migrations" }
  ],
  // Page JSON and images, extraction JSON, guidance. Private: read only through the Worker after the access check.
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "codebridge-mdt", "jurisdiction": "eu" }],
  "vars": {
    "AUTH_MODE": "demo",
    // "on" lets /api/health report features.data once the database is seeded; "off" keeps the page on embedded data.
    "DATA_API": "on",
    // Who may read clinical case content. "all_roles" keeps today's demo behaviour (coordinator and administrator
    // open every case); "doctors_only" applies INTEGRATION.md's rule. Open question: docs/agent/OPEN_QUESTIONS.md.
    "CLINICAL_ACCESS": "all_roles",
    // "true" lets the administrator restore the shared demo to its seed (POST /api/admin/reset-demo). Absent or any
    // other value in a pilot, where the data is not synthetic.
    "DEMO_RESET_ENABLED": "true",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "AZURE_OPENAI_BASE": "https://apim-rakathon-q7146n.azure-api.net/openai/v1",
    "AZURE_OPENAI_MODEL": "gpt-6-luna-dz-eu",
    "AI_GATEWAY_BASE": "",
    "LLM_MAX_ATTEMPTS": "4",
    "LLM_RETRY_BASE_MS": "1000",
    "SUMMARY_MAX_CHARS": "40000",
    "ELEVENLABS_API_BASE": "https://api.elevenlabs.io",
    "STT_REALTIME_MODEL": "scribe_v2_realtime",
    "STT_BATCH_MODEL": "scribe_v2",
    "STT_LANGUAGE": "cs",
    "STT_MAX_AUDIO_BYTES": "100000000",
    // Step 5: the speaker pass. Seed for best-effort determinism of a rerun ("" sends none).
    "STT_BATCH_SEED": "1",
    // Audio parts the page uploads while a case is discussed: exactly this size except the last (R2 multipart minimum).
    "AUDIO_PART_BYTES": "5242880",
    "AUDIO_MAX_MINUTES_PER_CASE": "120",
    // Step 6: what the upload route does with a file that is not a registered synthetic fixture. "fixtures_only"
    // refuses it and stores nothing (the shared demo); "store_unprocessed" stores it as "nezpracováno" (team staging,
    // local work). The page promises 20 MB per file.
    "UPLOAD_POLICY": "fixtures_only",
    "UPLOAD_MAX_BYTES": "20971520",
    // Step 6 (b-1): where the PageKit service runs (src/services/pagekit.ts). "" with no PAGEKIT container binding
    // switches the document pipeline off; local work sets it to the Python service, http://localhost:8080.
    "PAGEKIT_URL": "",
    "GIT_SHA": "dev"
  },
  // Limits are per Cloudflare location and approximate (eventually consistent). Generous on purpose:
  // in demo mode the key is the client IP, and the whole jury may share one venue Wi-Fi address.
  "ratelimits": [
    { "name": "RL_STT_TOKEN", "namespace_id": "26101", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_STT_BATCH", "namespace_id": "26102", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_LLM", "namespace_id": "26103", "simple": { "limit": 20, "period": 60 } },
    // Audio parts: one 5 MiB part is about 2.7 minutes of a case, so 30 a minute is far above a real meeting.
    { "name": "RL_AUDIO", "namespace_id": "26104", "simple": { "limit": 30, "period": 60 } },
    // Uploads: the intake demo is seven files at once, and in demo mode the limit is per IP, so a whole venue on one
    // Wi-Fi shares it; 200 a minute keeps repeated demo runs smooth while still capping a runaway client.
    { "name": "RL_UPLOAD", "namespace_id": "26105", "simple": { "limit": 200, "period": 60 } }
  ],
  // Step 5: the speaker pass after approval runs as a Workflow (durable steps, each retried on its own).
  "workflows": [
    { "name": "codebridge-speaker-pass", "binding": "SPEAKER_PASS", "class_name": "SpeakerPassWorkflow" },
    // Step 6: one stored PDF through the deterministic pipeline (render, Tesseract, readability, labs), no LLM.
    { "name": "codebridge-process-document", "binding": "PROCESS_DOCUMENT", "class_name": "ProcessDocumentWorkflow" }
  ],
  // The audio sweep (src/scheduled.ts): deletes audio every other path should already have deleted.
  "triggers": { "crons": ["*/15 * * * *"] }
}
