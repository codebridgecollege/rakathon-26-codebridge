{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "codebridge-mdt",
  "main": "src/index.ts",
  // Pinned so the runtime behaves the same on every deploy; not later than Wrangler 4.147.0's workerd.
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  // The backend branch deploys as a preview alias (backend-codebridge-mdt.<subdomain>.workers.dev).
  "preview_urls": true,
  "assets": {
    "directory": "./.assets",
    "binding": "ASSETS",
    // Only the API and the login run code; pages and images are served as files. The app's files hold no data, so
    // they stay public; every /api answer checks the session (docs/design/AUTH.md, "How login works").
    "run_worker_first": ["/api/*", "/auth/*"],
    "not_found_handling": "404-page"
  },
  // Logs hold route, status and timing only; handlers never log transcripts, audio or tokens.
  "observability": { "enabled": true },
  // Case data (step 2). Both were created with the EU jurisdiction; it can only be set at creation, and
  // `wrangler d1 info codebridge-mdt` reports "jurisdiction: eu". Identity lives in D1's patients table only.
  "d1_databases": [
    { "binding": "DB", "database_name": "codebridge-mdt", "database_id": "eac0ab4e-59fc-46a1-86cc-69b2f5f4b344", "migrations_dir": "migrations" }
  ],
  // Page JSON and images, extraction JSON, guidance. Private: read only through the Worker after the access check.
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "codebridge-mdt", "jurisdiction": "eu" }],
  // The login pages' text comes from the shared Fluent catalogs (i18n/<lang>/auth.ftl), imported as text.
  "rules": [{ "type": "Text", "globs": ["**/*.ftl", "**/*.txt"], "fallthrough": true }],
  "vars": {
    // "oidc": the login at the IdP (the deployed hosts). "demo": the user picker without a login; `npm run dev`, the
    // tests and the browser suite set it. Any other value fails closed (src/auth/middleware.ts).
    "AUTH_MODE": "oidc",
    // Zitadel Cloud, EU region (docs/design/AUTH.md). OIDC_CLIENT_SECRET and SESSION_KEY are Worker secrets.
    "OIDC_ISSUER": "https://glide-mdt--dev-dybk0r.eu1.zitadel.cloud",
    "OIDC_CLIENT_ID": "395716705399111846",
    // "on" lets /api/health report features.data once the database is seeded; "off" leaves the data routes unconfigured.
    "DATA_API": "on",
    // Who may read clinical case content. "all_roles" keeps today's demo behaviour (coordinator and administrator
    // open every case); "doctors_only" applies INTEGRATION.md's rule. Open question: docs/agent/OPEN_QUESTIONS.md.
    "CLINICAL_ACCESS": "all_roles",
    // "true" lets the administrator restore the shared demo to its seed (POST /api/admin/reset-demo). Absent or any
    // other value in a pilot, where the data is not synthetic.
    "DEMO_RESET_ENABLED": "true",
    "LLM_MAX_ATTEMPTS": "4",
    "LLM_RETRY_BASE_MS": "1000",
    "SUMMARY_MAX_CHARS": "40000",
    // Issue #20: the model the document pipeline sends pseudonymized text and redacted page images to
    // and the summary of a recorded discussion (src/services/model.ts). Provider "openrouter" reads the
    // OPENROUTER_API_KEY secret and must name the endpoint in MODEL_ROUTE_ONLY; "openai-compatible" reads MODEL_API_KEY.
    // Without the key the model is off.
    // The orgs whose documents the AI extraction reads ("*": all). Empty: off everywhere; real patients need FNO's
    // clearance for any cloud model first (DATA-PROTECTION.md).
    "MODEL_ORGS": "demo-a,demo-b,demo-c",
    // The Prognóza tab's study search sends a clinical profile (no name or birth number) to OpenRouter, with web search,
    // on a click. The orgs it may run for ("*": all); empty: off everywhere. It also needs the OPENROUTER_API_KEY secret
    // (wrangler secret put OPENROUTER_API_KEY). Real patients need FNO's clearance for any cloud model first.
    "PROGNOSIS_ORGS": "demo-a,demo-b,demo-c",
    // At most this many searches a day per org, a guard on the account's tokens.
    "PROGNOSIS_DAILY_MAX": "20",
    // The model's exact ID on OpenRouter, checked against its catalog at each search; no other model is substituted.
    "PROGNOSIS_MODEL": "anthropic/claude-opus-5.5",
    "PROGNOSIS_MODEL_LABEL": "Claude Opus 5.5",
    // The endpoint must run OpenRouter's web search: amazon-bedrock/eu-west-1 answered without searching (2026-11-06).
    "PROGNOSIS_ROUTE_ONLY": "google-vertex/europe",
    // Medium: "low" returned 2 rows from one study on a synthetic profile, "medium" 8 rows (2026-11-06).
    "OPENROUTER_REASONING_EFFORT": "medium",
    "MODEL_PROVIDER": "openrouter",
    "MODEL_BASE": "https://openrouter.ai/api/v1",
    "MODEL_NAME": "openai/gpt-6-luna",
    "MODEL_ROUTE_ONLY": "azure/eu",
    // Page images go to their own model: GPT-6 Luna dropped characters from clean print at every effort (2026-11-06), and
    // Haiku cannot take the extraction schema (Anthropic allows 16 nullable fields in a strict schema, ours has 31).
    "MODEL_READ_NAME": "anthropic/claude-haiku-5.5",
    "MODEL_READ_ROUTE_ONLY": "google-vertex/europe",
    "MODEL_REASONING_EFFORT": "low",
    "MODEL_TIMEOUT_MS": "120000",
    // In-process retries stop here, below the 5-minute step timeout (MODEL_STEP); the step retries after that.
    "MODEL_DEADLINE_MS": "150000",
    "MODEL_MAX_RETRY_WAIT_MS": "20000",
    "MODEL_MAX_INPUT_CHARS": "200000",
    "MODEL_MAX_IMAGE_BYTES": "4000000",
    "MODEL_MAX_OUTPUT_TOKENS": "8000",
    // The budget decides what is sent: pages per org and per case in the window, and calls per page.
    "MODEL_BUDGET_WINDOW_HOURS": "24",
    "MODEL_BUDGET_PAGES_PER_ORG": "600",
    "MODEL_BUDGET_PAGES_PER_CASE": "80",
    // A page can take four read attempts and four extraction attempts, so a failed read still leaves room to extract.
    "MODEL_BUDGET_CALLS_PER_PAGE": "8",
    "ELEVENLABS_API_BASE": "https://api.elevenlabs.io",
    "STT_REALTIME_MODEL": "scribe_v2_realtime",
    "STT_BATCH_MODEL": "scribe_v2",
    "STT_LANGUAGE": "cs",
    "STT_MAX_AUDIO_BYTES": "100000000",
    // Step 5: the speaker pass. Seed for best-effort determinism of a rerun ("" sends none).
    "STT_BATCH_SEED": "1",
    // Audio parts the page uploads while a case is discussed: exactly this size except the last (R2 multipart minimum).
    "AUDIO_PART_BYTES": "5242880",
    "AUDIO_MAX_MINUTES_PER_CASE": "120",
    // Step 6: what the upload route does with a file that is not a registered synthetic fixture. "fixtures_only" accepts
    // it and keeps only its listing (name, size, uploader, time), no content (the shared demo); "store_unprocessed" stores
    // an unknown PDF or JPEG/PNG photo as "nezpracováno" (team staging, local work). The page promises 20 MB per file.
    "UPLOAD_POLICY": "fixtures_only",
    // The team's switch: orgs (comma-separated ids) whose uploads keep their content whatever UPLOAD_POLICY says. Empty
    // on the deployed host; the team sets "demo-b" to test the pipeline on its own synthetic files in demo org B, and
    // empties it again afterwards (anyone with a demo account can act in org B, and its demo reset wipes it). Both demo
    // orgs are listed since 2026-11-05 (Soňa's decision). Real patient documents wait for FNO's clearance whatever this says.
    "UPLOAD_STORE_ORGS": "demo-a,demo-b,demo-c",
    "UPLOAD_MAX_BYTES": "20971520",
    // Step 6 (b-1): where the page reader service runs (src/services/page-reader.ts). PAGE_READER_URL wins when set:
    // local work points it at the Python service, http://localhost:8080. Otherwise PAGE_READER_CONTAINER "on" uses the
    // PAGE_READER container binding below. "off" here so anything that does not say otherwise fails closed (wrangler dev,
    // the tests, the browser suite run no container); CI's deploy commands pass `--var PAGE_READER_CONTAINER:on`.
    "PAGE_READER_URL": "",
    "PAGE_READER_CONTAINER": "off",
    // The orgs the pipeline runs for (comma-separated org ids, "*" for all). Both demo orgs since 2026-11-05; demo org
    // A's prepared runs stay as they are, since the case merge leaves a case whose run came from a fixture alone.
    "PIPELINE_ORGS": "demo-a,demo-b,demo-c",
    // Issue #22: each org's NIS (hospital system) over FHIR R4, as JSON keyed by org id; "{}" means none, and the page
    // shows no "Import z NIS". Shape and auth modes: src/services/fhir.ts and api/AGENTS.md, "NIS over FHIR". Local
    // work points an org at the test server: --var 'NIS_CONFIG:{"demo-a":{"base_url":"http://127.0.0.1:8090/fhir",
    // "label_cs":"Testovací NIS (syntetická data)","auth":{"mode":"none"}}}'.
    "NIS_CONFIG": "{}",
    "GIT_SHA": "dev"
  },
  // Limits are per Cloudflare location and approximate (eventually consistent). Generous on purpose:
  // in demo mode the key is the client IP, and the whole jury may share one venue Wi-Fi address.
  "ratelimits": [
    { "name": "RL_STT_TOKEN", "namespace_id": "26101", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_STT_BATCH", "namespace_id": "26102", "simple": { "limit": 10, "period": 60 } },
    // Audio parts: one 5 MiB part is about 2.7 minutes of a case, so 30 a minute is far above a real meeting.
    { "name": "RL_AUDIO", "namespace_id": "26104", "simple": { "limit": 30, "period": 60 } },
    // Uploads: the intake demo is seven files at once, and in demo mode the limit is per IP, so a whole venue on one
    // Wi-Fi shares it; 200 a minute keeps repeated demo runs smooth while still capping a runaway client.
    { "name": "RL_UPLOAD", "namespace_id": "26105", "simple": { "limit": 200, "period": 60 } }
  ],
  // Step 5: the speaker pass after approval runs as a Workflow (durable steps, each retried on its own).
  "workflows": [
    { "name": "codebridge-speaker-pass", "binding": "SPEAKER_PASS", "class_name": "SpeakerPassWorkflow" },
    // Step 6: one stored PDF through the deterministic pipeline (render, Tesseract, readability, labs), no LLM.
    { "name": "codebridge-process-document", "binding": "PROCESS_DOCUMENT", "class_name": "ProcessDocumentWorkflow" },
    // Issue #20: the AI part of a document after its pipeline run (vision reading, fact extraction), ending in the
    // case merge. Only for orgs in MODEL_ORGS.
    { "name": "codebridge-extract-document", "binding": "EXTRACT_DOCUMENT", "class_name": "ExtractDocumentWorkflow" },
    // Issue #18: a case's run composed from its documents' fragments (store/case-merge.ts), after every document run.
    { "name": "codebridge-process-case", "binding": "PROCESS_CASE", "class_name": "ProcessCaseWorkflow" },
    // The Prognóza tab's study search: one model call with web search per click (src/workflows/prognosis.ts).
    { "name": "codebridge-prognosis", "binding": "PROGNOSIS", "class_name": "PrognosisWorkflow" }
  ],
  // The audio sweep (src/scheduled.ts): deletes audio every other path should already have deleted.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Step 6: the page reader container. Its class lives in its own Worker, codebridge-page-reader
  // (page-reader.wrangler.jsonc, src/page-reader-worker.ts), which holds the containers entry (EU jurisdiction) and the
  // class migration; this Worker only binds it. A Worker that defines a Durable Object class would lose the backend
  // branch's preview alias. Locally the binding points at a Worker that is not running, so PAGE_READER_CONTAINER stays
  // "off" there.
  "durable_objects": { "bindings": [{ "name": "PAGE_READER", "class_name": "PageReader", "script_name": "codebridge-page-reader" }] }
}
