{
  "name": "codebridge-api",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "stage": "bash scripts/stage-assets.sh",
    "dev": "npm run stage && wrangler dev",
    "types": "wrangler types src/worker-configuration.d.ts --strict-vars=false --env-file .dev.vars.example",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "pretest": "node -e \"require('fs').mkdirSync('.assets',{recursive:true})\"",
    "test": "vitest run",
    "deploy": "npm run stage && wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
