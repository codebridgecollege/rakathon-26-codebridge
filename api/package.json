{
  "name": "codebridge-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "stage": "bash scripts/stage-assets.sh",
    "dev": "npm run stage && wrangler dev --var AUTH_MODE:demo",
    "dev:oidc": "npm run stage && wrangler dev",
    "types": "wrangler types src/worker-configuration.d.ts --strict-vars=false --env-file .dev.vars.example",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "pretest": "node -e \"require('fs').mkdirSync('.assets',{recursive:true})\"",
    "test": "vitest run",
    "deploy": "npm run stage && wrangler deploy --var PAGE_READER_CONTAINER:on",
    "seed:local": "uv run seed/seed.py --target local --reset",
    "seed:remote": "uv run seed/seed.py --target remote",
    "seed:remote:reset": "uv run seed/seed.py --target remote --reset",
    "migrate:local": "wrangler d1 migrations apply codebridge-mdt --local",
    "migrate:remote": "wrangler d1 migrations apply codebridge-mdt --remote"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@codebridge/domain": "0.0.0",
    "hono": "4.13.13",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
