# Real patient data never enters git: keep it in private/ or outside the
# repo. data/ holds the organizers' synthetic challenge data and is committed.
private/
*.local.*

# Secrets
.env
.env.*
!.env.example

# Per-user agent settings
CLAUDE.local.md
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Node
node_modules/
# Model answers and bundles of the offline extraction harness (api/scripts/extract-eval.ts)
api/.cache/
.next/
.nuxt/
.output/
.nitro/
.data/
# nuxt generate links app/dist to .output/public (a symlink, so dist/ above does not match it).
app/dist
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Logs, which may contain prompts or document text
logs/
*.log

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# API keys kept as files
.elevenlabs-key
*.key

# Recordings stay out of git: the organizer talks exceed GitHub's 100 MB
# file limit, and the team's own discussions carry our voices. The
# transcripts are committed instead.
*.m4a
*.mp4

# Guideline PDFs are downloaded only to extract quotes; they are copyrighted and the app opens them online.
docs/sources/guidelines/

# Temporary git worktrees that review agents use
.claude/worktrees/
.wrangler/

# Local secrets for wrangler dev (the API Worker).
.dev.vars
.dev.vars.*
!.dev.vars.example

# Static files the API Worker serves, staged by api/scripts/stage-assets.sh.
api/.assets/

# Seed output (generated SQL, R2 bodies, identity scan, upload state); rebuilt by api/seed/seed.py.
api/seed/out/

# Intermediate screenshots of scripts/cover/build.mjs (rebuilt each run).
scripts/cover/shots/
docs/submission/variants/*@2x.png
docs/submission/og@2x.png
